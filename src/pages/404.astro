---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Halaman tidak ditemukan" noindex>
  <section class="section">
    <div class="container-x max-w-3xl py-12 text-center">
      <p class="eyebrow mb-4">Error 404</p>
      <h1 class="h1">Halaman ini tidak ada</h1>
      <p class="lead mx-auto mt-6 max-w-xl">Mungkin alamatnya salah ketik, atau halamannya sudah dipindah.</p>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href="/" class="btn btn-primary">Kembali ke beranda →</a>
        <a href="/projects" class="btn btn-secondary">Lihat proyek</a>
      </div>
    </div>
  </section>
</BaseLayout>
