---
interface Props {
  eyebrow?: string;
  title?: string;
  intro?: string;
  center?: boolean;
  id?: string;
}
const { eyebrow, title, intro, center = false, id } = Astro.props;
---

{
  (eyebrow || title || intro) && (
    <header class:list={['mb-10 md:mb-14 max-w-3xl', center && 'mx-auto text-center']} data-reveal>
      {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
      {title && (
        <h2 class="h2" id={id}>
          {title}
        </h2>
      )}
      {intro && <p class="lead mt-4">{intro}</p>}
    </header>
  )
}
