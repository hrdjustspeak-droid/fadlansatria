---
import { getNavigation, getSite, isExternal } from '../lib/content';

const [site, nav] = await Promise.all([getSite(Astro.locals), getNavigation(Astro.locals)]);
const year = new Date().getFullYear();
---

<footer class="site-footer mt-auto">
  <div class="container-x grid gap-12 py-16 md:grid-cols-12 md:py-20">
    <div class="md:col-span-5">
      <p class="font-head text-2xl" style="font-weight:var(--heading-weight)">{site.ownerName}</p>
      <p class="meta mt-1">{site.role}</p>
      <a href={`mailto:${site.email}`} class="link mt-6 inline-block font-semibold">{site.email}</a>
      {site.cvFile && <a href={site.cvFile} class="btn btn-secondary mt-6 flex w-fit" download>Download CV</a>}
    </div>
    {
      nav.footer.length > 0 && (
        <nav aria-label="Menu footer" class="md:col-span-3">
          <ul class="flex flex-col gap-1" role="list">
            {nav.footer.map((m) => (
              <li>
                <a href={m.href} class="footer-link" target={isExternal(m.href) ? '_blank' : undefined} rel={isExternal(m.href) ? 'noopener' : undefined}>
                  {m.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
    {
      site.socials.length > 0 && (
        <div class="md:col-span-4">
          <h2 class="meta mb-3 font-semibold">Sosial media</h2>
          <ul class="flex flex-wrap gap-2" role="list">
            {site.socials.map((s) => (
              <li>
                <a href={s.url} class="badge social" target="_blank" rel="noopener me">
                  {s.platform} ↗
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
  <div class="container-x divider-t flex flex-wrap items-center justify-between gap-4 py-6">
    <p class="meta">
      © {year}
      {site.ownerName}.{site.footerText && ` ${site.footerText}`}
    </p>
    <a href="#top" class="link meta font-semibold">Kembali ke atas ↑</a>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--surface);
  }
  .footer-link {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    text-decoration: none;
  }
  .footer-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .social {
    min-height: 40px;
    text-decoration: none;
    background: var(--bg);
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .social:hover {
    background: var(--text);
    color: var(--bg);
  }
</style>
