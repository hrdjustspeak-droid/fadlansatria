---
import type { Section } from '../../lib/schemas';

interface Props {
  data: Extract<Section, { type: 'map' }>;
}
const { data } = Astro.props;
const frameTitle = `Peta lokasi${data.address ? `: ${data.address}` : ''}`;
---

<section class="section">
  <div class="container-x">
    {
      data.variant === 'split' ? (
        <div class="grid items-stretch gap-8 md:grid-cols-12">
          <div class="flex flex-col gap-6 md:col-span-5" data-reveal>
            {data.title && <h2 class="h2">{data.title}</h2>}
            {data.address && (
              <div>
                <h3 class="meta mb-1 font-semibold">Alamat</h3>
                <p>{data.address}</p>
              </div>
            )}
            {data.hours && (
              <div>
                <h3 class="meta mb-1 font-semibold">Jam buka</h3>
                <p class="whitespace-pre-line">{data.hours}</p>
              </div>
            )}
          </div>
          <div class="card overflow-hidden md:col-span-7" data-reveal>
            <iframe src={data.embedUrl} title={frameTitle} loading="lazy" referrerpolicy="no-referrer-when-downgrade" class="block aspect-[4/3] h-full w-full border-0" />
          </div>
        </div>
      ) : (
        <>
          {data.title && <h2 class="h2 mb-8" data-reveal>{data.title}</h2>}
          <div class="card overflow-hidden" data-reveal>
            <iframe src={data.embedUrl} title={frameTitle} loading="lazy" referrerpolicy="no-referrer-when-downgrade" class="block aspect-[4/3] w-full border-0 md:aspect-[21/9]" />
          </div>
          {(data.address || data.hours) && (
            <p class="meta mt-4">
              {data.address}
              {data.address && data.hours && ' · '}
              {data.hours}
            </p>
          )}
        </>
      )
    }
  </div>
</section>
