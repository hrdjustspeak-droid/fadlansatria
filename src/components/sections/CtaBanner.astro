---
import type { Section } from '../../lib/schemas';
import { ctaHref, isExternal } from '../../lib/content';

interface Props {
  data: Extract<Section, { type: 'ctaBanner' }>;
}
const { data } = Astro.props;
const href = await ctaHref(data.button, 'Banner CTA');
const ext = isExternal(href);
---

<section class="section">
  <div class="container-x">
    <div class="cta-band card flex flex-col items-start gap-8 p-8 md:flex-row md:items-center md:justify-between md:p-16" data-reveal>
      <h2 class="h2 max-w-3xl">{data.headline}</h2>
      <a href={href} class="btn cta-btn shrink-0" target={ext ? '_blank' : undefined} rel={ext ? 'noopener' : undefined}>
        {data.button.label}<span aria-hidden="true">{ext ? '↗' : '→'}</span>
      </a>
    </div>
  </div>
</section>

<style>
  /* Latar aksen + teks --accent-contrast (dijamin 4,5:1 oleh engine kontras). */
  .cta-band {
    background: var(--accent);
    color: var(--accent-contrast);
  }
  .cta-btn {
    background: var(--accent-contrast);
    color: var(--accent);
    border-color: var(--accent-contrast);
  }
  .cta-btn:hover {
    background: transparent;
    color: var(--accent-contrast);
  }
  .cta-band :focus-visible {
    outline-color: var(--accent-contrast);
  }
</style>
